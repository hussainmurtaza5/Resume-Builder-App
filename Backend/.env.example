# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret

# Postgres connection string for persistent storage (Vercel Postgres / Neon).
# On Vercel, leaving this empty falls back to an ephemeral /tmp SQLite file,
# which is wiped whenever the function instance restarts.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Keep these variables only in the backend/Vercel environment.
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=1200

# Comma-separated exact browser origins; do not use '*'.
# Example: https://resume-builder.vercel.app,http://localhost:5173
FRONTEND_ORIGINS=https://your-frontend-domain.com
